# ── afterimage configuration ──────────────────────────────────
# Copy to .env and adjust. All variables are optional except AFTERIMAGE_ROOT.

# Path to your video storage root (required)
AFTERIMAGE_ROOT=/data/lifelog

# Server mode: "lifelog" (full UI + API + MCP) or "public" (file browser only)
AFTERIMAGE_MODE=lifelog

# Public origin used in MCP endpoint discovery and asset URLs
AFTERIMAGE_ORIGIN=http://localhost:8901

# Separate origin for video/asset files (e.g. a CDN or NAS URL).
# Defaults to AFTERIMAGE_ORIGIN if unset.
# AFTERIMAGE_ASSET_ORIGIN=

# Bind address and port
HOST=0.0.0.0
PORT=8901

# ── STT (Speech-to-Text) ─────────────────────────────────────
# Provider: "whisper" (local, default), "openai", or "none" (skip transcription)
STT_PROVIDER=whisper

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# OpenAI API key (required when STT_PROVIDER=openai)
# OPENAI_API_KEY=

# Optional context hint passed to the STT engine for better accuracy
# STT_CONTEXT=Daily lifelog footage.

# ── Ingest pipeline ──────────────────────────────────────────
# Generate web-ready preview videos (requires ffmpeg, slower but enables streaming)
GENERATE_PREVIEW=true

# Seconds a file must be unchanged before processing (guards against partial uploads)
STABLE_SECONDS=10

# Cache directory for temporary work files
# AFTERIMAGE_CACHE=/tmp/afterimage-cache
