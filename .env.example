# ── afterimage configuration ──────────────────────────────────
# Copy to .env and adjust. All variables are optional except AFTERIMAGE_ROOT.

# Path to your video storage root (required)
AFTERIMAGE_ROOT=/data/lifelog

# Server mode: "lifelog" (full UI + API + MCP) or "public" (file browser only)
AFTERIMAGE_MODE=lifelog

# Public origin used in MCP endpoint discovery and asset URLs
AFTERIMAGE_ORIGIN=http://localhost:8901

# Separate origin for video/asset files (e.g. a CDN or NAS URL).
# Defaults to AFTERIMAGE_ORIGIN if unset.
# AFTERIMAGE_ASSET_ORIGIN=

# Container listens internally on all interfaces, but Compose publishes to loopback by default.
# Set BIND_ADDRESS=0.0.0.0 only after configuring authentication.
BIND_ADDRESS=127.0.0.1
HOST=0.0.0.0
PORT=8901

# Include local Whisper in the Docker image. Set 0 for an API/VLM-only lightweight image.
INSTALL_LOCAL_WHISPER=1

# ── Authentication ────────────────────────────────────────────
# Strongly recommended whenever HOST is not loopback. Configure a bearer token,
# Basic credentials, or both. /_health remains public for container probes.
# AFTERIMAGE_AUTH_TOKEN=replace-with-a-long-random-value
# AFTERIMAGE_AUTH_USER=afterimage
# AFTERIMAGE_AUTH_PASSWORD=replace-with-a-long-random-value

# ── STT (Speech-to-Text) ─────────────────────────────────────
# Provider: "whisper" (local, default), "openai", or "none" (skip transcription)
STT_PROVIDER=whisper

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# OpenAI API key (required when STT_PROVIDER=openai)
# OPENAI_API_KEY=

# Optional context hint passed to the STT engine for better accuracy
# STT_CONTEXT=Daily lifelog footage.

# ── VLM (visual scene analysis) ───────────────────────────────
# Provider: none (default), gemini, openai, openai-compatible, or ollama
VLM_PROVIDER=none
# VLM_MODEL=gemini-3.1-flash-lite
# VLM_API_KEY=
# VLM_BASE_URL=http://host.docker.internal:11434
# Sample one frame every N seconds, capped per video to control cost.
VLM_FRAME_INTERVAL=60
VLM_MAX_FRAMES=12
VLM_TIMEOUT=120

# ── Ingest pipeline ──────────────────────────────────────────
# Generate web-ready preview videos (requires ffmpeg, slower but enables streaming)
GENERATE_PREVIEW=true

# Seconds a file must be unchanged before processing (guards against partial uploads)
STABLE_SECONDS=10

# Cache directory for temporary work files
# AFTERIMAGE_CACHE=/tmp/afterimage-cache
